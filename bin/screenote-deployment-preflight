#!/usr/bin/env ruby
# frozen_string_literal: true

begin
  ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
  require "rubygems"
  require "bundler/setup"
  require_relative "../lib/screenote/deployment_preflight"
rescue LoadError, StandardError
  warn "screenote deployment preflight: cannot load deployment identity checker"
  exit 1
end

begin
  Screenote::DeploymentPreflight.call(
    storage_root: ENV.fetch("SCREENOTE_STORAGE_ROOT", "/rails/storage")
  )
rescue Screenote::DeploymentPreflight::Mismatch => error
  warn "screenote deployment preflight: #{error.message}"
  exit 1
rescue StandardError
  warn "screenote deployment preflight: cannot verify deployment identity"
  exit 1
end
