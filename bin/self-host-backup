#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "optparse"
require_relative "../lib/screenote/self_hosted/host_operations"

options = { compose_files: [], project_name: "screenote", timeout: 120 }
parser = OptionParser.new do |value|
  value.banner = <<~USAGE
    Usage: bin/self-host-backup --destination ABSOLUTE_PATH --recipient AGE_RECIPIENT \
      --authentication-key ABSOLUTE_FILE \
      --configuration ABSOLUTE_FILE --secret-bundle ABSOLUTE_DIRECTORY \
      --image IMAGE@SHA256 --predecessor IMAGE_OR_NONE --compose-file ABSOLUTE_FILE
  USAGE
  value.on("--destination PATH") { |input| options[:destination] = input }
  value.on("--recipient RECIPIENT") { |input| options[:recipient] = input }
  value.on("--authentication-key FILE") { |input| options[:authentication_key] = input }
  value.on("--configuration FILE") { |input| options[:configuration] = input }
  value.on("--secret-bundle DIRECTORY") { |input| options[:secret_bundle] = input }
  value.on("--image IMAGE@SHA256") { |input| options[:image] = input }
  value.on("--predecessor IMAGE_OR_NONE") { |input| options[:predecessor] = input }
  value.on("--compose-file FILE") { |input| options[:compose_files] << input }
  value.on("--project-name NAME") { |input| options[:project_name] = input }
  value.on("--timeout SECONDS") { |input| options[:timeout] = input }
  value.on("--s3-snapshot-command FILE") { |input| options[:s3_snapshot_command] = input }
  value.on("--s3-evidence FILE") { |input| options[:s3_evidence] = input }
end

begin
  parser.parse!(ARGV)
  required = %i[destination recipient authentication_key configuration secret_bundle image predecessor]
  missing = required.find { |name| options[name].to_s.empty? }
  if !ARGV.empty? || missing
    warn missing ? "self-host backup: missing --#{missing.to_s.tr('_', '-')}" : parser.to_s
    exit 64
  end
  exit Screenote::SelfHosted::HostOperations::BackupCommand.new(options).call
rescue OptionParser::ParseError => error
  warn "self-host backup: #{error.message}"
  exit 64
end
