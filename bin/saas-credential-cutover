#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "open3"
require "optparse"
require "securerandom"
require "time"

module ScreenoteSaasCredentialCutoverCommand
  EVIDENCE_SCHEMA = "screenote-saas-cutover-backup/v1"
  EVIDENCE_KEYS = %w[
    schema
    status
    predecessor_version
    successor_version
    quiesced_at
    quiescence_challenge
    completed_at
    restore_tested_at
    backup_reference_sha256
    database_restore_point_sha256
    database_roles
  ].freeze
  DATABASE_ROLES = %w[primary cache queue cable].freeze
  MAX_EVIDENCE_BYTES = 64 * 1024
  MAX_RESTORE_TEST_AGE = 30 * 24 * 60 * 60
  REVISION_PATTERN = /\A[0-9a-f]{40,64}\z/
  DIGEST_PATTERN = /\A[0-9a-f]{64}\z/

  class Error < StandardError; end

  class Runner
    def initialize(argv, environment: ENV)
      @environment = environment
      @options = parse(argv)
      @kamal = environment.fetch("SCREENOTE_KAMAL_BIN", File.expand_path("kamal", __dir__))
      @lock_held = false
      @maintenance_entered = false
      @migration_started = false
      @quiesced_at = nil
      @quiescence_challenge = nil
    end

    def call
      validate!
      acquire_lock

      run_kamal("app", "maintenance", "--message", "Screenote credential maintenance", locked: true)
      @maintenance_entered = true
      run_kamal("app", "stop", locked: true)
      verify_processes_stopped!
      @quiesced_at = Time.now.utc.iso8601(6)
      run_backup_hook!
      validate_evidence!

      @migration_started = true
      run_kamal(
        "app", "exec", "--primary", "--version", options.fetch(:version),
        "--env", "SCREENOTE_SAAS_CREDENTIAL_CUTOVER:authorized",
        "bin/rails runner script/saas_credential_cutover_migrate",
        locked: true
      )

      run_kamal("app", "boot", "--version", options.fetch(:version), locked: true)
      run_kamal("app", "live", "--version", options.fetch(:version), locked: true)
      puts "SaaS credential cutover completed for #{options.fetch(:version)}."
      0
    rescue Error => error
      warn "saas credential cutover: #{error.message}"
      if @maintenance_entered
        warn "The application remains in maintenance. Do not start predecessor code against migrated state."
        warn "Restore the reviewed backup before starting #{options[:predecessor]}." if @migration_started
      end
      1
    ensure
      release_lock if @lock_held
    end

    private

    attr_reader :environment, :kamal, :options

    def parse(argv)
      values = {}
      parser = OptionParser.new do |options_parser|
        options_parser.banner = <<~BANNER
          Usage: bin/saas-credential-cutover --version SHA --predecessor SHA \
            --backup-hook FILE --backup-hook-sha256 SHA256 --backup-evidence FILE
        BANNER
        options_parser.on("--version REVISION") { |value| values[:version] = value }
        options_parser.on("--predecessor REVISION") { |value| values[:predecessor] = value }
        options_parser.on("--backup-evidence FILE") { |value| values[:evidence_path] = value }
        options_parser.on("--backup-hook FILE") { |value| values[:hook_path] = value }
        options_parser.on("--backup-hook-sha256 DIGEST") { |value| values[:hook_digest] = value }
        options_parser.on("--destination NAME") { |value| values[:destination] = value }
        options_parser.on("--config FILE") { |value| values[:config] = value }
      end
      parser.parse!(argv)
      raise Error, parser.to_s unless argv.empty?

      values.freeze
    rescue OptionParser::ParseError => error
      raise Error, error.message
    end

    def validate!
      %i[version predecessor evidence_path hook_path hook_digest].each do |key|
        raise Error, "missing --#{key.to_s.tr('_', '-')}" if options[key].to_s.empty?
      end
      raise Error, "version must be a full immutable revision" unless options[:version].match?(REVISION_PATTERN)
      unless options[:predecessor].match?(REVISION_PATTERN) && options[:predecessor] != options[:version]
        raise Error, "predecessor must be a different full immutable revision"
      end
      raise Error, "backup hook digest is invalid" unless options[:hook_digest].match?(DIGEST_PATTERN)

      validate_local_revision!
      validate_evidence_destination!
      validate_backup_hook!
    end

    def validate_local_revision!
      revision, status = Open3.capture2("git", "rev-parse", "HEAD")
      raise Error, "cannot verify the local revision" unless status.success?
      raise Error, "local revision does not match --version" unless revision.strip == options[:version]
    end

    def validate_evidence!
      path = @evidence_path
      stat = File.lstat(path)
      raise Error, "backup evidence must be a regular non-symlink file" unless stat.file? && !stat.symlink?
      raise Error, "backup evidence must be owned by the current user" unless stat.uid == Process.uid
      raise Error, "backup evidence permissions must exclude group and other access" unless (stat.mode & 0o077).zero?
      raise Error, "backup evidence is too large" if stat.size > MAX_EVIDENCE_BYTES

      evidence = JSON.parse(File.binread(path))
      raise Error, "backup evidence must be one JSON object" unless evidence.instance_of?(Hash)
      raise Error, "backup evidence fields are invalid" unless evidence.keys.sort == EVIDENCE_KEYS.sort
      raise Error, "backup evidence schema is unsupported" unless evidence["schema"] == EVIDENCE_SCHEMA
      raise Error, "backup evidence is not verified" unless evidence["status"] == "verified"
      raise Error, "backup evidence predecessor does not match" unless evidence["predecessor_version"] == options[:predecessor]
      raise Error, "backup evidence successor does not match" unless evidence["successor_version"] == options[:version]
      unless evidence["backup_reference_sha256"].is_a?(String) && evidence["backup_reference_sha256"].match?(DIGEST_PATTERN)
        raise Error, "backup reference digest is invalid"
      end
      unless evidence["database_restore_point_sha256"].is_a?(String) &&
          evidence["database_restore_point_sha256"].match?(DIGEST_PATTERN)
        raise Error, "database restore point digest is invalid"
      end
      raise Error, "backup evidence does not cover every database role" unless evidence["database_roles"] == DATABASE_ROLES

      quiesced_at = parse_time(evidence.fetch("quiesced_at"), field: "quiesced_at")
      completed_at = parse_time(evidence.fetch("completed_at"), field: "completed_at")
      restore_tested_at = parse_time(evidence.fetch("restore_tested_at"), field: "restore_tested_at")
      validation_time = Time.now.utc
      expected_quiesced_at = Time.iso8601(@quiesced_at).utc
      unless quiesced_at == expected_quiesced_at
        raise Error, "backup evidence quiescence does not match this stopped process window"
      end
      challenge = evidence["quiescence_challenge"]
      unless challenge.is_a?(String) && challenge.match?(DIGEST_PATTERN) &&
          secure_equal?(challenge, @quiescence_challenge)
        raise Error, "backup evidence challenge does not match this stopped process window"
      end
      raise Error, "backup completed before the application was quiesced" if completed_at < quiesced_at
      raise Error, "backup evidence is from the future" if completed_at > validation_time || restore_tested_at > validation_time
      if validation_time - restore_tested_at > MAX_RESTORE_TEST_AGE
        raise Error, "backup restore test is older than 30 days"
      end
    rescue Errno::ENOENT, Errno::EACCES, JSON::ParserError, TypeError
      raise Error, "backup evidence is unavailable or invalid"
    end

    def validate_evidence_destination!
      @evidence_path = File.expand_path(options.fetch(:evidence_path))
      raise Error, "backup evidence output must not exist before quiescence" if File.exist?(@evidence_path)

      parent = File.realpath(File.dirname(@evidence_path))
      stat = File.lstat(parent)
      unless stat.directory? && !stat.symlink? && stat.uid == Process.uid && (stat.mode & 0o077).zero?
        raise Error, "backup evidence directory must be a private owned directory"
      end
    rescue Errno::ENOENT, Errno::EACCES
      raise Error, "backup evidence directory is unavailable"
    end

    def validate_backup_hook!
      @hook_path = File.expand_path(options.fetch(:hook_path))
      stat = File.lstat(@hook_path)
      unless stat.file? && !stat.symlink? && stat.uid == Process.uid && (stat.mode & 0o077).zero? && stat.executable?
        raise Error, "backup hook must be a private owned executable file"
      end
      actual_digest = Digest::SHA256.file(@hook_path).hexdigest
      raise Error, "backup hook digest does not match" unless secure_equal?(actual_digest, options.fetch(:hook_digest))
    rescue Errno::ENOENT, Errno::EACCES
      raise Error, "backup hook is unavailable"
    end

    def run_backup_hook!
      validate_backup_hook!
      @quiescence_challenge = SecureRandom.hex(32)
      hook_environment = {
        "SCREENOTE_CUTOVER_QUIESCED_AT" => @quiesced_at,
        "SCREENOTE_CUTOVER_CHALLENGE" => @quiescence_challenge,
        "SCREENOTE_CUTOVER_EVIDENCE_PATH" => @evidence_path,
        "SCREENOTE_CUTOVER_PREDECESSOR" => options.fetch(:predecessor),
        "SCREENOTE_CUTOVER_SUCCESSOR" => options.fetch(:version)
      }
      raise Error, "quiesced backup hook failed" unless system(hook_environment, @hook_path)
    end

    def parse_time(value, field:)
      raise Error, "backup evidence #{field} is invalid" unless value.is_a?(String)

      Time.iso8601(value).utc
    rescue ArgumentError
      raise Error, "backup evidence #{field} is invalid"
    end

    def secure_equal?(left, right)
      return false unless left.bytesize == right.bytesize

      result = 0
      left.bytes.zip(right.bytes) { |first, second| result |= first ^ second }
      result.zero?
    end

    def acquire_lock
      run_kamal("lock", "acquire", "--message", "Screenote stopped-process credential cutover")
      @lock_held = true
    end

    def release_lock
      run_kamal("lock", "release")
    rescue Error => error
      warn "saas credential cutover: #{error.message}; release the Kamal lock manually"
    ensure
      @lock_held = false
    end

    def verify_processes_stopped!
      output = capture_kamal("app", "containers", "--quiet", locked: true)
      active = output.each_line.any? { |line| line.match?(/\b(?:Up|Restarting)\b/i) }
      raise Error, "an application or worker process is still running" if active
    end

    def run_kamal(*arguments, locked: false)
      command = command_for(arguments)
      command_environment = locked ? { "KAMAL_LOCK" => "true" } : {}
      raise Error, "Kamal command failed: #{arguments.first(2).join(' ')}" unless system(command_environment, *command)
    end

    def capture_kamal(*arguments, locked: false)
      command = command_for(arguments)
      command_environment = locked ? { "KAMAL_LOCK" => "true" } : {}
      stdout, _stderr, status = Open3.capture3(command_environment, *command)
      raise Error, "Kamal command failed: #{arguments.first(2).join(' ')}" unless status.success?

      stdout
    end

    def command_for(arguments)
      command = [ kamal, *arguments ]
      command.concat([ "--destination", options[:destination] ]) if options[:destination]
      command.concat([ "--config-file", options.fetch(:config, "config/deploy.saas.yml") ])
      command
    end
  end
end

exit ScreenoteSaasCredentialCutoverCommand::Runner.new(ARGV).call
