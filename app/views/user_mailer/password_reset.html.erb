<% content_for :preheader do %>Reset your Screenote password<% end %>

<!-- Title -->
<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 900; color: #e8e8ed; font-family: Georgia, 'Times New Roman', serif; letter-spacing: -0.02em;">
  Reset your password
</h1>
<p style="margin: 0 0 28px 0; font-size: 15px; color: #8888a0; line-height: 1.5;">
  It happens to the best of us.
</p>

<!-- Body text -->
<p style="margin: 0 0 28px 0; font-size: 15px; color: #b0b0c0; line-height: 1.7;">
  We received a request to reset the password for your Screenote account. Click the button below to choose a new password.
</p>

<!-- CTA Button -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
  <tr>
    <td align="center">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="<%= main_app.edit_password_url(@password_reset_token) %>" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="17%" fillcolor="#e5a31e" stroke="f">
        <w:anchorlock/>
        <center style="color:#0a0a0f;font-family:Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;font-weight:bold;">Reset Password</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="<%= main_app.edit_password_url(@password_reset_token) %>" class="email-btn" style="display: inline-block; padding: 14px 36px; background-color: #e5a31e; color: #0a0a0f; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 8px; mso-hide: all;">
        Reset Password
      </a>
      <!--<![endif]-->
    </td>
  </tr>
</table>

<!-- Expiry note -->
<p style="margin: 0 0 20px 0; font-size: 13px; color: #5a5a6e; line-height: 1.6;">
  This link expires in 15 minutes. If you didn't request a password reset, you can safely ignore this email &mdash; your password will remain unchanged.
</p>

<!-- Fallback URL -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid #1e1e2a;">
  <tr>
    <td style="padding-top: 20px;">
      <p style="margin: 0 0 6px 0; font-size: 12px; color: #5a5a6e;">
        Button not working? Copy and paste this URL:
      </p>
      <p style="margin: 0; font-size: 12px; color: #8888a0; word-break: break-all;">
        <%= main_app.edit_password_url(@password_reset_token) %>
      </p>
    </td>
  </tr>
</table>
