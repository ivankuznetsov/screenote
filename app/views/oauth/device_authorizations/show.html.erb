<div class="auth-card">
  <h1 class="auth-card__title">Authorize device</h1>
  <p class="auth-card__subtitle">
    <strong data-testid="device-client-name"><%= @device_grant.application.name %></strong>
    wants to use your Screenote account.
  </p>

  <p class="oauth-consent__explanation">
    Confirm that this code matches the one shown by the device you are signing in:
    <strong data-testid="device-user-code"><%= @device_grant.user_code %></strong>
  </p>

  <div class="oauth-consent__scopes">
    <p class="oauth-consent__scopes-label">This application will be able to:</p>
    <ul class="oauth-consent__scopes-list">
      <% @device_grant.scopes.split.each do |scope| %>
        <li class="oauth-consent__scope-item" data-testid="device-scope-<%= scope.tr('_', '-') %>">
          <% if scope == "mcp_read" %>
            Read screenshots, annotations, project members, invitations, and their email addresses
          <% else %>
            Create and change screenshots, annotations, projects, invitations, and project membership, including removing members
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <%= form_with url: oauth_device_path, method: :post, class: "oauth-consent__form", data: { turbo: false } do %>
    <%= hidden_field_tag :user_code, @device_grant.user_code %>
    <div class="auth-card__field oauth-consent__principal">
      <%= label_tag :principal_project_id, "Authorize access to", class: "auth-card__label" %>
      <%= select_tag :principal_project_id,
        options_for_select(
          [ [ "My Screenote account (all current projects)", "" ] ] +
            @principal_projects.map { |project| [ project.name, project.id ] },
          @selected_principal_project_id
        ),
        class: "auth-card__input",
        data: { testid: "device-principal-select" } %>
      <p class="oauth-consent__explanation">
        Choose one project to keep this device isolated, or your account to let it use projects you can access.
      </p>
      <% if @principal_selection_error %>
        <p class="auth-card__error" data-testid="device-principal-error"><%= @principal_selection_error %></p>
      <% end %>
    </div>
    <div class="oauth-consent__actions">
      <%= button_tag "Approve", type: "submit", name: "decision", value: "approve", class: "auth-card__submit" %>
    </div>
    <div class="oauth-consent__deny">
      <%= button_tag "Deny", type: "submit", name: "decision", value: "deny", class: "auth-card__magic-link" %>
    </div>
  <% end %>
</div>
