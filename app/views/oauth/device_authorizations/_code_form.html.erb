<%= form_with url: oauth_device_path, method: :get, class: "auth-card__form", data: { turbo: false } do |form| %>
  <div class="auth-card__field">
    <%= form.label :user_code, "One-time code", class: "auth-card__label" %>
    <%= form.text_field :user_code, value: params[:user_code], class: "auth-card__input", autocomplete: "one-time-code", autocapitalize: "characters", required: true %>
  </div>
  <%= form.submit "Continue", class: "auth-card__submit" %>
<% end %>
