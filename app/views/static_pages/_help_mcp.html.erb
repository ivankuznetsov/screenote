<%# ── Connecting Other Agents via MCP ── %>
<section class="guide__section" id="mcp">
  <h2 class="guide__section-heading">Connecting Other Agents via MCP</h2>
  <p class="guide__section-desc">Any AI agent that supports the Model Context Protocol can connect to Screenote. The Claude Code plugin handles this automatically, but you can also connect other agents directly.</p>

  <%# MCP Endpoint %>
  <div class="guide__mcp-block">
    <h3 class="guide__mcp-label">MCP Endpoint</h3>
    <div class="guide__terminal">
      <div class="guide__terminal-bar">
        <span class="guide__terminal-dot"></span>
        <span class="guide__terminal-dot"></span>
        <span class="guide__terminal-dot"></span>
      </div>
      <div class="guide__terminal-body">
        <div class="guide__terminal-line">
          <code><%= root_url %>mcp</code>
        </div>
      </div>
    </div>
  </div>

  <%# Authentication %>
  <div class="guide__mcp-block">
    <h3 class="guide__mcp-label">Authentication</h3>

    <div class="guide__mcp-method">
      <h4 class="guide__mcp-method-title">OAuth 2.1 &mdash; recommended for MCP clients</h4>
      <p class="guide__mcp-method-desc">Most MCP clients (Claude Code, Cursor, etc.) use OAuth automatically. Your server advertises its configuration via standard discovery endpoints:</p>
      <ul class="guide__mcp-list">
        <li>Discovery: <code>GET /.well-known/oauth-authorization-server</code></li>
        <li>Dynamic Client Registration: <code>POST /oauth/register</code> (RFC 7591)</li>
        <li>Authorization: <code>GET /oauth/authorize</code> with PKCE (required)</li>
        <li>Token exchange: <code>POST /oauth/token</code></li>
      </ul>
      <p class="guide__mcp-method-desc">Scopes: <code>mcp_read</code> (default), <code>mcp_write</code> (optional). Access tokens expire in 1 hour; refresh tokens are enabled.</p>
    </div>

    <div class="guide__mcp-method">
      <h4 class="guide__mcp-method-title">API Keys &mdash; simple, single-project</h4>
      <p class="guide__mcp-method-desc">For simpler integrations, create an API key in your project settings and use it as a Bearer token:</p>
      <div class="guide__terminal">
        <div class="guide__terminal-bar">
          <span class="guide__terminal-dot"></span>
          <span class="guide__terminal-dot"></span>
          <span class="guide__terminal-dot"></span>
        </div>
        <div class="guide__terminal-body">
          <div class="guide__terminal-line">
            <code>Authorization: Bearer sk_proj_...</code>
          </div>
        </div>
      </div>
      <p class="guide__mcp-method-desc">Each API key is scoped to a single project. Go to your project &rarr; API Keys to create one.</p>
    </div>
  </div>

  <%# project_id note %>
  <div class="guide__mcp-block">
    <h3 class="guide__mcp-label">A note on project_id</h3>
    <p class="guide__mcp-method-desc">How you pass the project depends on your authentication method:</p>
    <ul class="guide__mcp-list">
      <li><strong>API key auth:</strong> The project is implicit &mdash; the <code>project_id</code> parameter is optional in tool calls.</li>
      <li><strong>OAuth auth:</strong> You must pass <code>project_id</code> to each tool call that requires it.</li>
    </ul>
  </div>
</section>

<%# ── MCP Tools Reference ── %>
<% if tools.any? %>
  <section class="guide__section" id="tools-reference">
    <h2 class="guide__section-heading">MCP Tools Reference</h2>
    <p class="guide__section-desc">These are the MCP tools your AI agent uses under the hood. The <code>/screenote</code> commands handle everything automatically, but you can also call these tools directly from any MCP client.</p>

    <div class="guide__tools-grid">
      <% tools.each do |tool| %>
        <% schema = tool.input_schema_to_json %>
        <% properties = schema[:properties] || {} %>
        <% required_params = schema[:required]&.map(&:to_s) || [] %>
        <div class="guide__tool" data-testid="tool-card">
          <div class="guide__tool-name"><%= tool.tool_name %></div>
          <div class="guide__tool-desc"><%= tool.description %></div>
          <% if properties.any? %>
            <div class="guide__tool-params">
              <div class="guide__tool-params-label">Parameters</div>
              <ul class="guide__tool-params-list">
                <% properties.each do |param_name, param_meta| %>
                  <li>
                    <code><%= param_name %></code>
                    <% if required_params.include?(param_name.to_s) %>
                      <span class="guide__tool-required">required</span>
                    <% end %>
                    &mdash; <%= param_meta[:description] %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
