<%# ── Quick Start with the Screenote CLI ── %>
<section class="guide__section" id="install-cli">

  <%# Step 1: Install %>
  <div class="guide__step">
    <span class="guide__step-number">1</span>
    <div class="guide__step-content">
      <h2 class="guide__step-title">Install the CLI</h2>
      <p class="guide__step-desc">On macOS, Homebrew is the recommended installation:</p>
      <%= render "static_pages/help_terminal", commands: [ "brew install ivankuznetsov/tap/screenote" ] %>
      <p class="guide__step-desc">Or install the checksum-verified release binary on macOS or Linux:</p>
      <%= render "static_pages/help_terminal", commands: [ "curl -fsSL https://screenote.ai/install.sh | sh" ] %>
      <p class="guide__step-desc">No Go toolchain or manual <code>PATH</code> setup is required. The <%= link_to "CLI source, releases, and documentation", "https://github.com/ivankuznetsov/screenote-cli" %> are public.</p>
    </div>
  </div>

  <%# Step 2: Authorize %>
  <div class="guide__step">
    <span class="guide__step-number">2</span>
    <div class="guide__step-content">
      <h2 class="guide__step-title">Sign in</h2>
      <p class="guide__step-desc">Authorize the CLI with your Screenote account:</p>
      <% login_command = Screenote::Deployment.current.saas? ? "screenote login" : "screenote --base-url #{Screenote::Deployment.current.base_url} login" %>
      <% device_login_command = "#{login_command} --device" %>
      <%= render "static_pages/help_terminal", commands: [ login_command ] %>
      <p class="guide__step-desc">A browser window opens for OAuth approval. Your credentials are saved locally with owner-only permissions.</p>
      <p class="guide__step-desc">On SSH, tmux, or another headless session, use device authorization instead:</p>
      <%= render "static_pages/help_terminal", commands: [ device_login_command ] %>
      <p class="guide__step-desc">Screenote prints a one-time code and authorization link. Open the link on any device, enter the code, and return to your terminal. No callback port or SSH forwarding is required.</p>
    </div>
  </div>

  <%# Step 3: Select a project %>
  <div class="guide__step">
    <span class="guide__step-number">3</span>
    <div class="guide__step-content">
      <h2 class="guide__step-title">Choose a project</h2>
      <p class="guide__step-desc">Create a project from the terminal, or use the <%= link_to "dashboard", dashboard_path %>. Then save the project ID your agent should use:</p>
      <%= render "static_pages/help_terminal", commands: [
        'screenote project create --name "My app"',
        "screenote project list",
        "screenote config set --project <PROJECT_ID>"
      ] %>
    </div>
  </div>

  <%# Step 4: Publish %>
  <div class="guide__step">
    <span class="guide__step-number">4</span>
    <div class="guide__step-content">
      <h2 class="guide__step-title">Publish a capture</h2>
      <p class="guide__step-desc">The CLI uploads PNG or JPEG files already produced by your agent or capture tool. Publish one image or a complete multi-page snapshot:</p>
      <%= render "static_pages/help_terminal", commands: [
        'screenote screenshot create --title "Homepage" --file screenshot.png',
        "screenote snapshot --manifest snapshot.json"
      ] %>
      <p class="guide__step-desc">A successful snapshot returns a review URL. See the <%= link_to "snapshot manifest guide", "https://github.com/ivankuznetsov/screenote-cli/blob/main/docs/snapshot-manifest.md" %> for the versioned JSON format.</p>
    </div>
  </div>

</section>
