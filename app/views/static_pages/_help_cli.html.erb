<%# ── CLI command and automation reference ── %>
<section class="guide__section" id="cli-reference">
  <h2 class="guide__section-heading">CLI reference</h2>
  <p class="guide__section-desc">Use these commands directly from an agent, a shell, or CI. Commands emit machine-readable JSON so automation can consume the result.</p>

  <div class="guide__cli-block">
    <h3 class="guide__cli-label">Read and comment on feedback</h3>
    <%= render "static_pages/help_terminal", commands: [
      "screenote screenshot list --status ready",
      "screenote annotation list --screenshot <SCREENSHOT_ID> --status open",
      "screenote annotation get --annotation <ANNOTATION_ID> --crop-file annotation.png",
      'screenote comment add --annotation <ANNOTATION_ID> --body "Fix applied in abc1234"',
      'screenote annotation resolve --annotation <ANNOTATION_ID> --comment "Verified and resolved"'
    ] %>
    <p class="guide__cli-method-desc"><code>--crop-file</code> saves the annotated image region with owner-only permissions. Add a comment to record what changed, then resolve the annotation idempotently with an optional resolution note.</p>
  </div>

  <div class="guide__cli-block">
    <h3 class="guide__cli-label">Headless and remote sessions</h3>
    <div class="guide__cli-method">
      <p class="guide__cli-method-desc">On SSH, tmux, or a remote agent host, sign in with the OAuth device flow. Open the printed link on any browser and approve the one-time code:</p>
      <%= render "static_pages/help_terminal", commands: [
        Screenote::Deployment.current.saas? ? "screenote login --device" : "screenote --base-url #{Screenote::Deployment.current.base_url} login --device",
        "screenote config set --project <PROJECT_ID>"
      ] %>
      <p class="guide__cli-method-desc">The CLI stores the OAuth credentials locally with owner-only permissions. It does not need a callback listener or SSH port forward.</p>
    </div>
  </div>

  <div class="guide__cli-block">
    <h3 class="guide__cli-label">Full documentation</h3>
    <ul class="guide__cli-list">
      <li><%= link_to "Public Screenote CLI repository", "https://github.com/ivankuznetsov/screenote-cli" %></li>
      <li><%= link_to "Snapshot manifest format", "https://github.com/ivankuznetsov/screenote-cli/blob/main/docs/snapshot-manifest.md" %></li>
    </ul>
  </div>
</section>
