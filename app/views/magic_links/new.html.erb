<div class="auth-card">
  <h1 class="auth-card__title">Magic Link</h1>
  <p class="auth-card__subtitle">We'll email you a link to sign in instantly.</p>

  <%= form_with url: request_magic_link_path, class: "auth-card__form" do |form| %>
    <div class="auth-card__field">
      <%= form.label :email, "Email", class: "auth-card__label" %>
      <%= form.email_field :email, class: "auth-card__input", required: true,
            autofocus: true, autocomplete: "email" %>
    </div>
    <div class="auth-card__actions">
      <%= form.submit "Send Magic Link", class: "auth-card__submit" %>
    </div>
  <% end %>

  <div class="auth-card__footer">
    <%= link_to "Sign in with password", new_session_path, class: "auth-card__link" %>
  </div>
</div>
