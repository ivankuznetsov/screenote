<%= link_to "← Back to project", project_path(@project), class: "breadcrumb-link" %>

<div class="page-header">
  <h1 class="page-header__title">Members</h1>
</div>

<% if @is_owner %>
  <% if !Screenote::Deployment.current.billing? || Current.user.can_invite_member?(@project) %>
    <div class="card project-members__invite">
      <h2 class="project-members__section-title">Invite a collaborator</h2>
      <%= form_with model: ProjectInvitation.new, url: project_invitations_path(@project), class: "project-members__invite-form" do |f| %>
        <%= f.label :email, "Collaborator email", class: "form__label" %>
        <div class="project-members__invite-row"
             data-controller="email-autocomplete"
             data-email-autocomplete-url-value="<%= project_collaborator_suggestions_path(@project) %>">
          <%= f.email_field :email,
                placeholder: "colleague@example.com",
                class: "form__input project-members__invite-input",
                required: true,
                autocomplete: "off",
                role: "combobox",
                aria: { expanded: false, autocomplete: "list", owns: "autocomplete-results" },
                data: { "1p-ignore": "", email_autocomplete_target: "input", action: "input->email-autocomplete#search keydown->email-autocomplete#navigate" } %>
          <%= f.submit "Invite", class: "btn btn--primary" %>
          <ul id="autocomplete-results" class="autocomplete-suggestions" data-email-autocomplete-target="results" role="listbox" hidden></ul>
        </div>
      <% end %>
    </div>
  <% elsif Screenote::Deployment.current.billing? %>
    <div class="upgrade-banner">
      <div class="upgrade-banner__text">You've reached the free plan limit of 1 team member. Upgrade to invite more collaborators.</div>
      <%= link_to "Upgrade to Pro for $#{Subscription::PRO_PRICE_CENTS / 100}/mo", subscription_path, class: "upgrade-banner__link" %>
    </div>
  <% end %>
<% end %>

<div class="project-members__section">
  <h2 class="project-members__section-title">Team (<%= @memberships.size %>)</h2>
  <div class="project-members__list">
    <% @memberships.each do |membership| %>
      <div class="project-members__item">
        <div class="project-members__info">
          <span class="project-members__email"><%= membership.user.email %></span>
          <span class="role-badge role-badge--<%= membership.role %>"><%= membership.role.capitalize %></span>
        </div>
        <% if @is_owner && membership.user != Current.user %>
          <%= button_to "Remove", project_membership_path(@project, membership), method: :delete, class: "btn btn--danger btn--small", data: { turbo_confirm: "Remove #{membership.user.email} from this project?" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @pending_invitations.any? %>
  <div class="project-members__section">
    <h2 class="project-members__section-title">Pending invitations (<%= @pending_invitations.size %>)</h2>
    <div class="project-members__list">
      <% @pending_invitations.each do |invitation| %>
        <div class="project-members__item">
          <div class="project-members__info">
            <span class="project-members__email"><%= invitation.email %></span>
            <span class="project-members__pending-label">Invited <%= time_ago_in_words(invitation.created_at) %> ago</span>
            <% if @is_owner %>
              <% if (presentation = @pending_invitation_presentations[invitation.id]) %>
                <div data-turbo-temporary data-testid="invitation-credential">
                  <p class="form__hint">
                    Private credential: share this link or manual code only with <%= invitation.email %>.
                  </p>
                  <label class="form__label" for="invitation-link-<%= invitation.id %>">Private invitation link</label>
                  <input id="invitation-link-<%= invitation.id %>"
                         class="form__input"
                         type="text"
                         value="<%= presentation.url %>"
                         readonly
                         aria-describedby="invitation-warning-<%= invitation.id %>">
                  <span id="invitation-warning-<%= invitation.id %>" class="form__hint">Select and copy the complete value.</span>
                  <label class="form__label" for="invitation-code-<%= invitation.id %>">Manual code</label>
                  <input id="invitation-code-<%= invitation.id %>"
                         class="form__input"
                         type="text"
                         value="<%= presentation.manual_code %>"
                         readonly>
                </div>
              <% else %>
                <p class="form__hint">This link is no longer available. Reissue the invitation to create a new one.</p>
                <%= button_to "Reissue",
                      project_invitations_path(@project),
                      method: :post,
                      params: { project_invitation: { email: invitation.email } },
                      class: "btn btn--secondary btn--small" %>
              <% end %>
            <% end %>
          </div>
          <% if @is_owner %>
            <%= button_to "Cancel", project_invitation_path(@project, invitation), method: :delete, class: "btn btn--secondary btn--small", data: { turbo_confirm: "Cancel invitation to #{invitation.email}?" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
