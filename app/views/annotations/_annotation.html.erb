<% author_color = annotation_author_color(annotation.user) %>
<% author_initials = annotation_author_initials(annotation.user) %>
<div class="annotation-item annotation-item--<%= annotation.status %> <%= author_color %>" id="<%= dom_id(annotation) %>"
  data-testid="annotation-item"
  data-action="click->annotorious#selectSidebarAnnotation"
  data-annotation-id="<%= annotation.id %>"
  data-status="<%= annotation.status %>"
  data-x-percent="<%= annotation.x_percent %>"
  data-y-percent="<%= annotation.y_percent %>"
  data-width-percent="<%= annotation.width_percent %>"
  data-height-percent="<%= annotation.height_percent %>"
  data-author-initials="<%= author_initials %>"
  data-author-color="<%= author_color %>"
  >
  <div class="annotation-item__header">
    <button type="button"
            class="annotation-author-marker <%= author_color %>"
            aria-label="Show annotation by <%= annotation.user.email %>"
            data-author-color="<%= author_color %>"
            data-testid="annotation-author-marker"><%= author_initials %></button>
    <span class="annotation-item__author"><%= annotation.user.email %></span>
    <span class="annotation-item__time"><%= time_ago_in_words(annotation.created_at) %> ago</span>
  </div>

  <% if annotation.comment.present? %>
    <div class="annotation-item__comment" data-testid="annotation-comment"><%= annotation.comment %></div>
  <% end %>

  <% if annotation.annotation_comments.any? %>
    <div class="annotation-thread">
      <% annotation.annotation_comments.each do |ac| %>
        <% author = ac.user || ac.api_key %>
        <% thread_author_color = annotation_author_color(author) %>
        <div class="annotation-thread__entry annotation-thread__entry--<%= ac.action %>" data-testid="thread-entry">
          <div class="annotation-thread__meta">
            <span class="annotation-thread__author-marker <%= thread_author_color %>"
                  data-author-color="<%= thread_author_color %>"
                  data-testid="thread-author-marker"><%= annotation_author_initials(author) %></span>
            <% if ac.resolved? %>
              <span class="annotation-thread__badge annotation-thread__badge--resolved">Resolved</span>
            <% elsif ac.reopened? %>
              <span class="annotation-thread__badge annotation-thread__badge--reopened">Unresolved</span>
            <% end %>
            <span class="annotation-thread__author"><%= ac.user&.email || ac.api_key&.name || "AI Agent" %></span>
            <span class="annotation-thread__time"><%= time_ago_in_words(ac.created_at) %> ago</span>
          </div>
          <div class="annotation-thread__body"><%= ac.body %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if annotation.resolved? %>
    <div class="annotation-item__meta">
      <span class="annotation-item__status annotation-item__status--resolved">Resolved</span>
    </div>
  <% end %>

  <div class="annotation-item__actions">
    <% if annotation.open? %>
      <%= button_to "Resolve",
          screenshot_annotation_path(annotation.screenshot, annotation),
          method: :patch,
          params: { annotation: { status: :resolved } },
          class: "btn btn--small btn--secondary",
          data: { testid: "resolve-annotation-button" } %>
    <% end %>
    <%= button_to "Delete",
        screenshot_annotation_path(annotation.screenshot, annotation),
        method: :delete,
        class: "btn btn--small btn--danger",
        data: { turbo_confirm: "Delete this annotation?", testid: "delete-annotation-button" } %>
  </div>

  <details class="annotation-thread__form-wrapper annotation-thread__form-wrapper--reply">
    <summary class="btn btn--small btn--secondary" data-testid="reply-toggle">Reply</summary>
    <%= form_with url: screenshot_annotation_annotation_comments_path(
          annotation.screenshot, annotation),
        method: :post,
        class: "annotation-thread__form annotation-thread__form--reply" do |f| %>
      <%= f.text_area :body, name: "annotation_comment[body]",
          class: "annotation-thread__textarea",
          placeholder: "Write a reply...",
          required: true,
          rows: 2,
          data: { testid: "reply-textarea" } %>
      <div class="annotation-thread__form-actions">
        <%= f.submit "Reply", class: "btn btn--small btn--primary", data: { testid: "reply-button" } %>
      </div>
    <% end %>
  </details>

  <% if annotation.resolved? %>
    <details class="annotation-thread__form-wrapper" data-testid="unresolve-form">
      <summary class="btn btn--small btn--warning" data-testid="unresolve-button">Unresolve</summary>
      <%= form_with url: screenshot_annotation_annotation_comments_path(
            annotation.screenshot, annotation),
          method: :post,
          class: "annotation-thread__form" do |f| %>
        <%= f.hidden_field :reopen, name: "annotation_comment[reopen]", value: "1" %>
        <%= f.text_area :body, name: "annotation_comment[body]",
            class: "annotation-thread__textarea",
            placeholder: "Explain why you're unresolving this...",
            rows: 2 %>
        <div class="annotation-thread__form-actions">
          <%= f.submit "Unresolve", class: "btn btn--small btn--warning", data: { testid: "submit-unresolve-button" } %>
        </div>
      <% end %>
    </details>
  <% end %>
</div>
