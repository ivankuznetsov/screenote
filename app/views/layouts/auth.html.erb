<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Screenote" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Screenote">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="auth-body">
    <div class="auth-shell">
      <div class="auth-shell__side">
        <div class="auth-shell__brand">
          <%= link_to "Screenote", main_app.root_path, class: "auth-shell__logo" %>
        </div>
        <div class="auth-shell__tagline">
          <p class="auth-shell__tagline-text">Visual feedback<br>for AI agents</p>
        </div>
        <div class="auth-shell__decoration">
          <div class="auth-shell__grid"></div>
        </div>
      </div>
      <div class="auth-shell__main">
        <% if flash[:notice] %>
          <div class="flash flash--notice"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flash flash--alert"><%= flash[:alert] %></div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
