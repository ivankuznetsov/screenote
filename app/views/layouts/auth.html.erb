<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
  </head>

  <body class="auth-body">
    <% if flash[:notice] %>
      <div class="flash flash--notice" data-testid="flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash--alert" data-testid="flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <div class="auth-shell">
      <div class="auth-shell__side">
        <div class="auth-shell__brand">
          <%= link_to main_app.root_path, class: "auth-shell__logo" do %>
            <%= render "shared/logo_icon" %>
            Screenote
          <% end %>
        </div>
        <div class="auth-shell__tagline">
          <p class="auth-shell__tagline-text">Visual feedback<br>for AI agents</p>
        </div>
        <div class="auth-shell__decoration">
          <div class="auth-shell__grid"></div>
        </div>
      </div>
      <div class="auth-shell__main">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
