    <title><%= content_for(:title) || local_assigns.fetch(:default_title, "Screenote") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Screenote">
    <meta name="mobile-web-app-capable" content="yes">
    <meta property="og:site_name" content="Screenote">
    <meta property="og:type" content="website">
    <meta property="og:image" content="<%= "#{Screenote::Deployment.current.base_url}/og-image.png" %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= "#{Screenote::Deployment.current.base_url}/og-image.png" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% if Rails.env.production? && Screenote::Deployment.current.saas? && Screenote::Deployment.current.monitoring_configuration[:javascript_api_key].present? %>
      <%= javascript_include_tag "https://js.honeybadger.io/v6.11/honeybadger.min.js", nonce: true %>
      <%= javascript_tag nonce: true do %>
        Honeybadger.configure({
          apiKey: '<%= j(Screenote::Deployment.current.monitoring_configuration[:javascript_api_key].to_s) %>',
          environment: 'production',
          revision: '<%= j(ENV.fetch("KAMAL_VERSION", "unknown")) %>'
        });
      <% end %>
    <% end %>
