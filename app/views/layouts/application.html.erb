<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <header class="header">
      <div class="header__inner">
        <div class="header__logo">
          <%= link_to "Screenote", dashboard_path, class: "header__title" %>
        </div>
        <nav class="header__nav">
          <% if Current.user %>
            <span class="header__email"><%= Current.user.email %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "header__sign-out" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash[:notice] %>
      <div class="flash flash--notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash--alert"><%= flash[:alert] %></div>
    <% end %>

    <main class="main">
      <%= yield %>
    </main>
  </body>
</html>
