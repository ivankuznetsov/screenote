<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Screenote — Visual Feedback for AI Agents" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Screenshot. Annotate. Let your AI agent see what you see. Visual feedback that bridges the gap between humans and AI.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Screenote">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="landing-body">
    <% if flash[:notice] %>
      <div class="flash flash--notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="flash flash--alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </body>
</html>
