<%# Web fonts for the dark auth and landing shells. The content security policy
    allows Google Fonts on the SaaS edition only; other editions fall back to
    the system font stacks declared in auth.css and landing.css. %>
<% if Screenote::Deployment.current.saas? %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<% end %>
