<% content_for :head do %>
  <%= stylesheet_link_tag "annotorious" if @screenshot %>
<% end %>
<% content_for :main_class, "main--review" if @screenshot %>

<div class="page-detail__header">
  <nav class="page-detail__breadcrumb" data-testid="breadcrumb" aria-label="Page">
    <% path_segments = @page.path_segments %>
    <h1 class="page-detail__title route-breadcrumb" data-testid="page-detail-title">
      <%= render "shared/project_switcher", project: @project, projects: @projects %>
      <% if path_segments.any? %>
        <%= render "shared/route_segments", project: @project, segments: path_segments %>
      <% else %>
        <span class="route-breadcrumb__current" data-testid="breadcrumb-current" aria-current="page">/</span>
      <% end %>
    </h1>
  </nav>

  <div class="page-detail__actions">
    <%= link_to "Upload version", new_page_screenshot_path(@page), class: "btn btn--primary" %>
    <% if @screenshot %>
      <%= link_to "Edit version", edit_screenshot_path(@screenshot), class: "btn btn--secondary" %>
      <%= button_to "Delete version", screenshot_path(@screenshot), method: :delete,
          class: "btn btn--danger",
          data: { turbo_confirm: "Are you sure you want to delete this screenshot?", testid: "delete-screenshot-button" } %>
    <% end %>
  </div>
</div>

<% if @screenshot %>
  <div class="page-workspace">
    <div class="page-workspace__main">
      <%= render "screenshots/workspace" %>
    </div>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <div class="empty-state__title">No versions yet</div>
    <div class="empty-state__description">Upload a screenshot to start collecting annotations.</div>
    <%= link_to "Upload first version", new_page_screenshot_path(@page), class: "btn btn--primary" %>
  </div>
<% end %>
