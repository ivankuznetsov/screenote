<% if screenshots.any? %>
  <div class="screenshot-grid">
    <% screenshots.each do |screenshot| %>
      <%= link_to screenshot_path(screenshot), class: "screenshot-card" do %>
        <div class="screenshot-card__image">
          <% if screenshot.image.attached? %>
            <%= image_tag screenshot.image.variant(resize_to_limit: [800, 600]), alt: screenshot.title %>
          <% else %>
            <div class="screenshot-card__placeholder">No image</div>
          <% end %>
        </div>
        <div class="screenshot-card__info">
          <div class="screenshot-card__title" data-testid="screenshot-card-title"><%= screenshot.title %></div>
          <div class="screenshot-card__meta">
            <%= screenshot.try(:open_annotations_count_cache) || screenshot.annotations.open.count %> open
            <span class="screenshot-card__separator">&middot;</span>
            <%= screenshot.try(:annotations_count_cache) || screenshot.annotations.count %> total
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <div class="empty-state__title">No versions yet</div>
    <div class="empty-state__description">Upload a screenshot to start collecting annotations.</div>
    <%= link_to "Upload first version", new_page_screenshot_path(page), class: "btn btn--primary" %>
  </div>
<% end %>
