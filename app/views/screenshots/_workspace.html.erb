<%# Keep the switcher, canvas, and annotations in one frame so viewport and
    filter navigation update every viewport-scoped part of the workspace. %>
<%= turbo_frame_tag "screenshot_canvas" do %>
  <div class="review-toolbar">
    <%= render "screenshots/viewport_switcher",
        screenshot: @screenshot,
        active_viewport: @active_viewport,
        status: params[:status] %>

    <%= render "screenshots/version_selector",
        screenshots: @screenshots,
        selected_screenshot: @screenshot,
        active_viewport: @active_viewport %>
  </div>

  <div class="screenshot-workspace"
       data-controller="annotorious review-fullscreen"
       data-action="annotorious:saved-marker-selected->review-fullscreen#showComments"
       data-testid="screenshot-workspace">
    <div class="screenshot-canvas" data-annotorious-target="canvas">
      <button type="button"
              class="screenshot-comments-toggle"
              aria-controls="annotation-sidebar"
              aria-expanded="true"
              aria-label="Hide comments"
              title="Hide comments"
              data-action="review-fullscreen#toggleComments"
              data-review-fullscreen-target="commentsToggle"
              data-testid="review-comments-toggle">
        <span class="screenshot-comments-toggle__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
            <path d="M8 8h8M8 12h5" />
          </svg>
        </span>
      </button>

      <button type="button"
              class="screenshot-fullscreen-toggle"
              aria-label="Enter fullscreen"
              aria-pressed="false"
              title="Enter fullscreen"
              data-action="review-fullscreen#toggle"
              data-review-fullscreen-target="toggle"
              data-testid="review-fullscreen-toggle">
        <span class="screenshot-fullscreen-toggle__icon screenshot-fullscreen-toggle__icon--enter" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
          </svg>
        </span>
        <span class="screenshot-fullscreen-toggle__icon screenshot-fullscreen-toggle__icon--restore" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7" />
          </svg>
        </span>
      </button>

      <% if @screenshot_image&.image&.attached? %>
        <%= image_tag screenshot_image_media_path(@screenshot_image, :original),
            class: "screenshot-canvas__image",
            alt: @screenshot.title,
            data: {
              annotorious_target: "image",
              review_fullscreen_target: "image",
              testid: "screenshot-image"
            } %>
      <% end %>
    </div>

    <% filter_path = ->(status) {
      page_workspace_path_for(
        @screenshot,
        viewport: @active_viewport,
        status: status
      )
    } %>

    <aside id="annotation-sidebar" class="annotation-sidebar" data-testid="annotation-sidebar">
      <div class="annotation-sidebar__header">
        <h2 class="annotation-sidebar__title" data-testid="sidebar-title">Annotations</h2>
        <div class="annotation-sidebar__filters">
          <%= link_to "All", filter_path.call(nil),
              class: "annotation-filter #{'annotation-filter--active' unless params[:status]}",
              data: { turbo_frame: "screenshot_canvas", turbo_action: "advance" } %>
          <%= link_to "Open", filter_path.call(:open),
              class: "annotation-filter #{'annotation-filter--active' if params[:status] == 'open'}",
              data: { turbo_frame: "screenshot_canvas", turbo_action: "advance" } %>
          <%= link_to "Resolved", filter_path.call(:resolved),
              class: "annotation-filter #{'annotation-filter--active' if params[:status] == 'resolved'}",
              data: { turbo_frame: "screenshot_canvas", turbo_action: "advance" } %>
        </div>
      </div>

      <div class="annotation-sidebar__list">
        <template data-annotorious-target="formTemplate">
          <%= render "annotations/form", screenshot: @screenshot, active_viewport: @active_viewport %>
        </template>

        <% @annotations.each.with_index(1) do |annotation, index| %>
          <%= render "annotations/annotation", annotation: annotation, index: index %>
        <% end %>

        <% if @annotations.empty? %>
          <div class="annotation-sidebar__empty" data-testid="sidebar-empty">
            No annotations yet. Click on the image to add one.
          </div>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>
