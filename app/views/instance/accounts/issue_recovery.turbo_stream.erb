<%= turbo_stream.replace "recovery-reveal-container" do %>
  <div id="recovery-reveal-container">
    <%# Stream responses skip the layout, so the layout's flash region never renders here. %>
    <div class="flash flash--notice" role="status" data-turbo-temporary data-testid="flash-notice"><%= flash[:notice] %></div>
    <%= render "recovery_reveal", recovery: @recovery %>
  </div>
<% end %>
