<div class="project-detail__header">
  <div>
    <h1 class="project-detail__title"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="project-detail__description"><%= @project.description %></p>
    <% end %>
  </div>
  <div class="project-detail__actions">
    <%= link_to "Edit", edit_project_path(@project), class: "btn btn--secondary" %>
    <%= button_to "Delete", project_path(@project), method: :delete, class: "btn btn--danger btn--small",
        data: { turbo_confirm: "Are you sure you want to delete this project?" } %>
  </div>
</div>

<div class="card">
  <p>Screenshots and annotations will appear here in Phase 2.</p>
</div>
