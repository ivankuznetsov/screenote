<div class="cli-banner" hidden data-controller="dismissible" data-dismissible-key-value="cli-banner-dismissed" data-testid="cli-banner">
  <div class="cli-banner__content">
    <div class="cli-banner__icon" aria-hidden="true">&gt;_</div>
    <div>
      <div class="cli-banner__title">Install the Screenote CLI</div>
      <div class="cli-banner__description">Publish screenshot captures and retrieve visual feedback from any agent or automation.</div>
    </div>
  </div>
  <div class="cli-banner__actions">
    <%= link_to "Install CLI", help_path(anchor: "install-cli"), class: "btn btn--secondary btn--small", data: { testid: "cli-banner-cta" } %>
    <button class="cli-banner__dismiss" data-action="dismissible#dismiss" aria-label="Dismiss CLI installation prompt" data-testid="cli-banner-dismiss">&times;</button>
  </div>
</div>

<div class="page-header">
  <h1 class="page-header__title" data-testid="page-title">Projects</h1>
  <div class="page-header__actions">
    <% unless Current.user.pro? %>
      <%= link_to "Upgrade to Pro", subscription_path, class: "btn btn--secondary" %>
    <% end %>
    <%= link_to "New project", new_project_path, class: "btn btn--primary" %>
  </div>
</div>

<% unless Current.user.can_create_project? %>
  <div class="upgrade-banner" data-testid="upgrade-banner">
    <div class="upgrade-banner__text">You've reached the free plan limit of 1 project.</div>
    <%= link_to "Upgrade to Pro for $#{Subscription::PRO_PRICE_CENTS / 100}/mo", subscription_path, class: "upgrade-banner__link" %>
  </div>
<% end %>

<% if @projects.any? %>
  <div class="project-list" data-testid="project-list">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "project-card", data: { testid: "project-card" } do %>
        <% thumbnails = project.thumbnail_screenshots %>
        <% if thumbnails.any? %>
          <div class="project-card__thumbnails">
            <% thumbnails.each do |screenshot| %>
              <% if screenshot.primary_image&.overview_variants_warmed? %>
                <%= image_tag screenshot.primary_image.image.variant(:project_strip),
                      class: "project-card__thumbnail",
                      width: 120,
                      height: 80,
                      loading: "lazy",
                      decoding: "async",
                      alt: screenshot.title %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <div class="project-card__name" data-testid="project-card-name">
          <%= project.name %>
          <% unless @memberships_by_project[project.id]&.owner? %>
            <span class="role-badge role-badge--member">Member</span>
          <% end %>
        </div>
        <% if project.description.present? %>
          <div class="project-card__description"><%= truncate(project.description, length: 120) %></div>
        <% end %>
        <div class="project-card__meta">Created <%= time_ago_in_words(project.created_at) %> ago</div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <div class="empty-state__title">No projects yet</div>
    <div class="empty-state__description">Create a project to start collecting visual feedback.</div>
    <%= link_to "Create your first project", new_project_path, class: "btn btn--primary" %>
  </div>
<% end %>
