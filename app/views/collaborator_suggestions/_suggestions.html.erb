<% suggestions.each_with_index do |user, index| %>
  <li class="autocomplete-suggestions__item" role="option"
      id="suggestion-<%= index %>"
      data-email="<%= user.email %>"
      data-action="click->email-autocomplete#selectItem">
    <span class="autocomplete-suggestions__email"><%= user.email %></span>
  </li>
<% end %>
