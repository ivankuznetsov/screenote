<div class="auth-card">
  <h1 class="auth-card__title">Set New Password</h1>

  <%= form_with url: password_path, method: :patch, scope: :user, class: "auth-card__form" do |form| %>
    <div class="auth-card__field">
      <%= form.label :password, "New Password", class: "auth-card__label" %>
      <%= form.password_field :password,
            class: "auth-card__input #{'auth-card__input--error' if @errors&.dig(:password)&.any?}",
            required: true,
            autofocus: true,
            minlength: RailsSimpleAuth.configuration.password_minimum_length,
            autocomplete: "new-password" %>
      <% if @errors&.dig(:password)&.any? %>
        <p class="auth-card__field-error" role="alert"><%= @errors[:password].first %></p>
      <% end %>
    </div>

    <div class="auth-card__field">
      <%= form.label :password_confirmation, "Confirm Password", class: "auth-card__label" %>
      <%= form.password_field :password_confirmation,
            class: "auth-card__input #{'auth-card__input--error' if @errors&.dig(:password_confirmation)&.any?}",
            required: true,
            minlength: RailsSimpleAuth.configuration.password_minimum_length,
            autocomplete: "new-password" %>
      <% if @errors&.dig(:password_confirmation)&.any? %>
        <p class="auth-card__field-error" role="alert"><%= @errors[:password_confirmation].first %></p>
      <% end %>
    </div>

    <div class="auth-card__actions">
      <%= form.submit "Update Password", class: "auth-card__submit" %>
    </div>
  <% end %>
</div>
