#!/usr/bin/env ruby
# frozen_string_literal: true

require "etc"
require "fileutils"
require "json"
require "net/http"
require "open3"
require "securerandom"
require "set"
require "socket"
require "stringio"
require "tempfile"
require "tmpdir"
require "uri"
require "zlib"

module ScreenoteLoadDriver
  PROFILE_SCHEMA = "screenote-minimum-host-profile/v1"
  EVIDENCE_SCHEMA = "screenote-load-smoke/v2"
  IMAGE_PATTERN = /\A[^[:space:]@]+@sha256:[0-9a-f]{64}\z/
  SHA_PATTERN = /\A[0-9a-f]{40}\z/
  LOCK_PATTERN = /SQLite3::(?:BusyException|LockedException)|database (?:table )?is locked|deadlock/i
  DATABASES = %w[primary cache queue cable].freeze
  COMMAND_TIMEOUT_SECONDS = 120
  CLEANUP_TIMEOUT_SECONDS = 30
  QUEUE_DRAIN_TIMEOUT_OVERHEAD_SECONDS = 30
  TERMINATION_GRACE_SECONDS = 2

  class Error < StandardError; end

  class Metrics
    attr_reader :latencies_ms, :request_failures, :unhandled_lock_errors

    def initialize
      @latencies_ms = []
      @request_failures = 0
      @unhandled_lock_errors = 0
      @mutex = Mutex.new
    end

    def record_http(latency_ms:, response:, expected_status:, expected_body: nil, core: true)
      body = response.body.to_s
      success = response.code.to_i == expected_status && (!expected_body || expected_body.call(body))

      @mutex.synchronize do
        @latencies_ms << latency_ms if core
        @request_failures += 1 unless success
        @unhandled_lock_errors += 1 if body.match?(LOCK_PATTERN)
      end
    end

    def record_exception(error)
      @mutex.synchronize do
        @request_failures += 1
        @unhandled_lock_errors += 1 if error.message.match?(LOCK_PATTERN)
      end
    end

    def record_failure(count = 1)
      @mutex.synchronize { @request_failures += count }
    end

    def record_log_lock_errors(count)
      @mutex.synchronize { @unhandled_lock_errors += count }
    end

    def core_p95_ms
      self.class.percentile(latencies_ms, 0.95)
    end

    def self.percentile(values, proportion)
      return 0.0 if values.empty?

      ordered = values.sort
      rank = (ordered.length * proportion).ceil
      ordered.fetch([ rank - 1, 0 ].max).round(3)
    end
  end

  class ThrottledFile
    def initialize(path)
      @file = File.open(path, "rb")
    end

    def read(length = nil, output = nil)
      sleep 0.001
      @file.read(length, output)
    end

    def close
      @file.close
    end
  end

  class Runner
    def self.reconcile_mutation_bodies(prefix:, expected_count:, actual:)
      expected = Array.new(expected_count) { |index| format("%s%012d", prefix, index) }
      expected_set = expected.to_set
      counts = actual.tally
      {
        "lost" => expected.count { |body| counts.fetch(body, 0).zero? },
        "duplicates" => counts.sum { |body, count| expected_set.include?(body) ? [ count - 1, 0 ].max : count }
      }
    end

    def initialize(environment = ENV)
      @profile = parse_profile(environment.fetch("SCREENOTE_LOAD_EXPECTED_PROFILE"))
      @profile_id = profile.fetch("id")
      @image = environment.fetch("SCREENOTE_LOAD_IMAGE")
      @source_sha = environment.fetch("SCREENOTE_LOAD_SOURCE_SHA")
      @load = profile.fetch("load")
      @host = profile.fetch("host")
      @limits = profile.fetch("limits")
      @metrics = Metrics.new
      @container = "screenote-load-#{SecureRandom.hex(8)}"
      @volume = "screenote-load-#{SecureRandom.hex(8)}"
      @root = Dir.mktmpdir("screenote-load-driver.")
    rescue KeyError => error
      raise Error, "missing required environment: #{error.key}"
    end

    def run
      validate_inputs!
      validate_host!
      validate_image!
      prepare_runtime!
      start_container!
      verify_container_limits!
      wait_for_readiness!
      seed = seed_load_data!
      image_path = build_exact_png(File.join(root, "load.png"), load.fetch("upload_bytes"))
      workload = run_workload!(seed, image_path)
      queue_drain_seconds, queue_depth = wait_for_queue_drain
      reconciliation = reconcile_mutations(workload)
      integrity_errors = database_integrity_errors
      metrics.record_failure(upload_processing_failures(seed))
      metrics.record_log_lock_errors(container_lock_errors)

      evidence = {
        "schema" => EVIDENCE_SCHEMA,
        "source_sha" => source_sha,
        "image_digest" => image,
        "host_profile_id" => profile_id,
        "profile" => load,
        "metrics" => {
          "unhandled_lock_errors" => metrics.unhandled_lock_errors,
          "lost_mutations" => reconciliation.fetch("lost"),
          "duplicate_mutations" => reconciliation.fetch("duplicates"),
          "core_p95_ms" => metrics.core_p95_ms,
          "queue_drain_seconds" => queue_drain_seconds.round(3),
          "queue_depth_after_drain" => queue_depth,
          "integrity_errors" => integrity_errors,
          "request_failures" => metrics.request_failures
        }
      }
      puts JSON.generate(evidence)
    ensure
      cleanup!(raise_on_failure: $!.nil?)
    end

    private

    attr_reader :container, :host, :image, :limits, :load, :metrics,
      :profile, :profile_id, :root, :source_sha, :volume

    def parse_profile(raw)
      JSON.parse(raw)
    rescue JSON::ParserError
      raise Error, "SCREENOTE_LOAD_EXPECTED_PROFILE is not valid JSON"
    end

    def validate_inputs!
      raise Error, "unexpected profile schema" unless profile["schema"] == PROFILE_SCHEMA
      raise Error, "source revision must be a full lowercase commit SHA" unless source_sha.match?(SHA_PATTERN)
      raise Error, "candidate image must use an immutable digest" unless image.match?(IMAGE_PATTERN)
      raise Error, "only the Linux AMD64 minimum-host profile is supported" unless
        host.values_at("operating_system", "architecture") == %w[linux amd64]
      raise Error, "minimum-host container identity must be 1000:1000" unless
        host.values_at("uid", "gid") == [ 1_000, 1_000 ]
      raise Error, "minimum-host storage must be local SSD" unless
        host.fetch("storage").values_at("medium", "mode") == %w[ssd local]

      positive_integer_keys = %w[sessions simultaneous_uploads upload_bytes mutation_rate_per_second duration_seconds]
      raise Error, "load profile values must be positive integers" unless
        positive_integer_keys.all? { |key| load[key].is_a?(Integer) && load[key].positive? }
    end

    def validate_host!
      raise Error, "minimum host requires #{host.fetch('vcpus')} CPUs" if processor_count < host.fetch("vcpus")

      raise Error, "minimum host requires #{host.fetch('memory_bytes')} bytes of RAM" if
        total_memory_bytes < host.fetch("memory_bytes")
    rescue Errno::ENOENT, ArgumentError, TypeError
      raise Error, "cannot verify minimum-host capacity"
    end

    def processor_count
      Etc.nprocessors
    end

    def total_memory_bytes
      kilobytes = File.read("/proc/meminfo")[/^MemTotal:\s+(\d+)\s+kB$/, 1]
      Integer(kilobytes, 10) * 1_024
    end

    def validate_image!
      details = JSON.parse(command!("docker", "image", "inspect", image)).fetch(0)
      digests = details.fetch("RepoDigests")
      labels = details.dig("Config", "Labels") || {}
      raise Error, "candidate digest is not present in the local image store" unless digests.include?(image)
      raise Error, "candidate image source revision does not match" unless
        labels["org.opencontainers.image.revision"] == source_sha
      raise Error, "candidate image platform does not match profile" unless
        details.values_at("Os", "Architecture") == %w[linux amd64]
    rescue JSON::ParserError, KeyError
      raise Error, "candidate image inspection is malformed"
    end

    def prepare_runtime!
      secret = File.join(root, "secret_key_base")
      File.binwrite(secret, SecureRandom.base64(48))
      File.chmod(0o400, secret)

      if Process.uid != host.fetch("uid")
        command!(
          "docker", "run", "--rm", "--user", "0", "--entrypoint", "chown",
          "--volume", "#{root}:/screenote-secrets", image,
          "#{host.fetch('uid')}:#{host.fetch('gid')}",
          "/screenote-secrets/secret_key_base"
        )
      end

      @volume_created = true
      command!("docker", "volume", "create", volume)
      validate_volume_storage!
      @container_started = true
      command!(
        "docker", "run", "--rm", "--user", "0", "--entrypoint", "chown",
        "--volume", "#{volume}:/rails/storage", image,
        "#{host.fetch('uid')}:#{host.fetch('gid')}", "/rails/storage"
      )
    end

    def validate_volume_storage!
      stdout = command!(
        "docker", "run", "--rm", "--user", "0", "--entrypoint", "df",
        "--volume", "#{volume}:/rails/storage", image, "-Pk", "/rails/storage"
      )
      available_blocks = stdout.lines.last.to_s.split.fetch(3) { raise Error, "cannot read available storage" }
      available_bytes = Integer(available_blocks, 10) * 1_024
      storage_bytes = host.fetch("storage").fetch("bytes")
      raise Error, "minimum host requires #{storage_bytes} free storage bytes" if available_bytes < storage_bytes
    rescue ArgumentError
      raise Error, "cannot verify minimum-host storage capacity"
    end

    def start_container!
      @port = available_port
      @origin = "http://127.0.0.1:#{@port}"
      secret = File.join(root, "secret_key_base")
      command!(
        "docker", "run", "--detach", "--name", container, "--init",
        "--user", "#{host.fetch('uid')}:#{host.fetch('gid')}",
        "--cpus", host.fetch("vcpus").to_s,
        "--memory", host.fetch("memory_bytes").to_s,
        "--memory-swap", host.fetch("memory_bytes").to_s,
        "--publish", "127.0.0.1:#{@port}:80",
        "--volume", "#{volume}:/rails/storage",
        "--mount", "type=bind,source=#{secret},target=/run/secrets/screenote_secret_key_base,readonly",
        "--env", "RAILS_ENV=production",
        "--env", "RAILS_SERVE_STATIC_FILES=true",
        "--env", "RAILS_LOG_LEVEL=warn",
        "--env", "DISABLE_SSL=true",
        "--env", "SCREENOTE_EDITION=self_hosted",
        "--env", "SCREENOTE_BASE_URL=#{@origin}",
        "--env", "SCREENOTE_STORAGE=local",
        "--env", "SECRET_KEY_BASE_FILE=/run/secrets/screenote_secret_key_base",
        image
      )
    end

    def verify_container_limits!
      details = JSON.parse(command!("docker", "inspect", container)).fetch(0)
      expected_cpu = host.fetch("vcpus") * 1_000_000_000
      expected_memory = host.fetch("memory_bytes")
      raise Error, "candidate CPU limit does not match the minimum-host profile" unless
        details.dig("HostConfig", "NanoCpus") == expected_cpu
      raise Error, "candidate memory limit does not match the minimum-host profile" unless
        details.dig("HostConfig", "Memory") == expected_memory &&
          details.dig("HostConfig", "MemorySwap") == expected_memory
      raise Error, "candidate container identity does not match the minimum-host profile" unless
        details.dig("Config", "User") == "#{host.fetch('uid')}:#{host.fetch('gid')}"
    rescue JSON::ParserError, KeyError
      raise Error, "candidate container inspection is malformed"
    end

    def available_port
      TCPServer.open("127.0.0.1", 0) { |server| server.local_address.ip_port }
    end

    def wait_for_readiness!
      deadline = monotonic_time + 180
      uri = URI("#{@origin}/ready")
      loop do
        begin
          http = Net::HTTP.new(uri.host, uri.port)
          http.open_timeout = 5
          http.read_timeout = 5
          response = http.start { |connection| connection.get(uri.request_uri) }
          return if response.code.to_i == 200
        rescue Errno::ECONNREFUSED, Errno::ECONNRESET, EOFError, Net::OpenTimeout, Net::ReadTimeout
          nil
        end
        raise Error, "candidate container did not become ready" if monotonic_time >= deadline

        sleep 1
      end
    end

    def seed_load_data!
      stdout = docker_rails_runner(seed_script)
      parse_runner_json(stdout, "load seed")
    end

    def seed_script
      [
        "session_count = #{load.fetch('sessions')}",
        "upload_count = #{load.fetch('simultaneous_uploads')}",
        <<~'RUBY'
        require "json"
        require "securerandom"

        run_id = SecureRandom.hex(12)
        users = session_count.times.map do |index|
          User.create!(
            email: "load-#{run_id}-#{index}@example.invalid",
            password: SecureRandom.base64(36),
            confirmed_at: Time.current,
            access_status: :active
          )
        end
        installation = Installation.current!
        Installation.transaction do
          installation.lock!
          installation.update!(
            state: "claimed",
            administrator: users.first,
            claimed_at: Time.current
          )
        end
        project = Project.create!(name: "Load qualification #{run_id}", creator: users.first)
        users.drop(1).each { |user| project.project_memberships.create!(user: user, role: :owner) }
        keys = users.each_with_index.map do |user, index|
          project.api_keys.create!(name: "Load session #{index}", issued_by_user: user)
        end
        page = project.pages.create!(name: "/release-load-qualification")
        uploads = upload_count.times.map do |index|
          screenshot = page.screenshots.create!(title: "Concurrent upload #{index}")
          image = screenshot.screenshot_images.create!(viewport: :desktop)
          { "image_id" => image.id, "screenshot_id" => screenshot.id, "token" => image.generate_token_for(:upload) }
        end
        annotations = keys.each_with_index.map do |key, index|
          screenshot = page.screenshots.create!(title: "Mutation target #{index}")
          screenshot.screenshot_images.create!(viewport: :desktop)
          screenshot.annotations.create!(
            api_key: key,
            x_percent: (index * 3) % 90,
            y_percent: (index * 7) % 90,
            comment: "Load target #{index}",
            viewport: :desktop
          )
        end
        puts JSON.generate(
          "run_id" => run_id,
          "project_id" => project.id,
          "tokens" => keys.map(&:raw_token),
          "annotation_ids" => annotations.map(&:id),
          "uploads" => uploads
        )
      RUBY
      ].join("\n")
    end

    def build_exact_png(path, target_bytes)
      signature = "\x89PNG\r\n\x1a\n".b
      width = 2_560
      height = 2_729
      scanline = "\x00".b + ("\x00".b * (width * 3))
      ihdr = [ width, height, 8, 2, 0, 0, 0 ].pack("NNCCCCC")

      Tempfile.create([ "screenote-load-idat", ".bin" ], root) do |compressed|
        compressed.binmode
        deflater = Zlib::Deflate.new(Zlib::NO_COMPRESSION)
        height.times { compressed.write(deflater.deflate(scanline)) }
        compressed.write(deflater.finish)
        compressed.flush

        fixed_bytes = signature.bytesize + png_chunk_size(ihdr.bytesize) +
          png_chunk_size(compressed.size) + png_chunk_size(0) + 12
        text_prefix = "screenote\0".b
        padding_bytes = target_bytes - fixed_bytes
        raise Error, "upload profile is too small for a valid PNG" if padding_bytes < text_prefix.bytesize

        File.open(path, "wb") do |output|
          output.write(signature)
          write_png_chunk(output, "IHDR", StringIO.new(ihdr), ihdr.bytesize)
          write_png_padding_chunk(output, padding_bytes, text_prefix)
          compressed.rewind
          write_png_chunk(output, "IDAT", compressed, compressed.size)
          write_png_chunk(output, "IEND", StringIO.new("".b), 0)
        end
      ensure
        deflater&.close
      end
      raise Error, "generated upload does not match the exact profile size" unless File.size(path) == target_bytes

      path
    end

    def png_chunk_size(payload_bytes)
      payload_bytes + 12
    end

    def write_png_padding_chunk(output, payload_bytes, prefix)
      remaining = payload_bytes - prefix.bytesize
      write_png_chunk(output, "tEXt", StringIO.new(prefix), payload_bytes) do |writer|
        block = "x".b * (64 * 1_024)
        while remaining.positive?
          bytes = [ remaining, block.bytesize ].min
          writer.call(block.byteslice(0, bytes))
          remaining -= bytes
        end
      end
    end

    def write_png_chunk(output, type, input, payload_bytes)
      type = type.b
      output.write([ payload_bytes ].pack("N"))
      output.write(type)
      checksum = Zlib.crc32(type)
      written = 0
      writer = lambda do |bytes|
        output.write(bytes)
        checksum = Zlib.crc32(bytes, checksum)
        written += bytes.bytesize
      end
      while (bytes = input.read(64 * 1_024))
        writer.call(bytes)
      end
      yield writer if block_given?
      raise Error, "generated PNG chunk length is invalid" unless written == payload_bytes

      output.write([ checksum ].pack("N"))
    end

    def run_workload!(seed, image_path)
      sessions = load.fetch("sessions")
      tokens = seed.fetch("tokens")
      annotation_ids = seed.fetch("annotation_ids")
      raise Error, "seed did not create the requested authenticated sessions" unless
        tokens.length == sessions && tokens.uniq.length == sessions && annotation_ids.length == sessions

      queues = Array.new(sessions) { Queue.new }
      workers = sessions.times.map do |index|
        Thread.new { mutation_worker(queues.fetch(index), tokens.fetch(index), annotation_ids.fetch(index), seed.fetch("project_id")) }
      end
      upload_threads, upload_intervals = start_uploads(seed.fetch("uploads"), image_path)

      prefix = "screenote-load-#{seed.fetch('run_id')}-"
      expected_count = load.fetch("mutation_rate_per_second") * load.fetch("duration_seconds")
      started_at = monotonic_time
      expected_count.times do |index|
        target = started_at + (index.to_f / load.fetch("mutation_rate_per_second"))
        sleep(target - monotonic_time) if target > monotonic_time
        queues.fetch(index % sessions) << {
          body: format("%s%012d", prefix, index),
          scheduled_at: target
        }
      end
      remaining = started_at + load.fetch("duration_seconds") - monotonic_time
      sleep remaining if remaining.positive?
      queues.each(&:close)
      join_threads!(workers + upload_threads, limits.fetch("queue_drain_seconds_max"))

      metrics.record_failure unless uploads_overlap?(upload_intervals)
      { prefix: prefix, expected_count: expected_count }
    ensure
      queues&.each(&:close)
      [ *workers, *upload_threads ].compact.each do |thread|
        thread.kill if thread.alive?
        thread.join
      end
    end

    def join_threads!(threads, maximum_seconds)
      deadline = monotonic_time + maximum_seconds
      threads.each do |thread|
        remaining = deadline - monotonic_time
        thread.join(remaining) if remaining.positive?
      end
      raise Error, "workload clients did not finish before the qualification deadline" if threads.any?(&:alive?)
    end

    def mutation_worker(queue, token, annotation_id, project_id)
      uri = URI("#{@origin}/api/v1/annotations/#{annotation_id}/comments?project_id=#{project_id}")
      http = nil
      while (mutation = queue.pop)
        body = mutation.fetch(:body)
        scheduled_at = mutation.fetch(:scheduled_at)
        begin
          http = start_http(uri) unless http&.started?
          request = Net::HTTP::Post.new(uri)
          request["Authorization"] = "Bearer #{token}"
          request["Content-Type"] = "application/json"
          request.body = JSON.generate(body: body)
          response = http.request(request)
          metrics.record_http(
            latency_ms: (monotonic_time - scheduled_at) * 1_000,
            response: response,
            expected_status: 201,
            expected_body: ->(raw) { JSON.parse(raw).dig("comment", "body") == body }
          )
        rescue StandardError => error
          metrics.record_exception(error)
          finish_http(http)
          http = nil
        end
      end
    ensure
      finish_http(http)
    end

    def start_http(uri)
      Net::HTTP.new(uri.host, uri.port).tap do |http|
        http.open_timeout = 10
        http.read_timeout = 30
        http.keep_alive_timeout = 30
        http.start
      end
    end

    def finish_http(http)
      http&.finish if http&.started?
    rescue IOError, SystemCallError
      nil
    end

    def start_uploads(uploads, image_path)
      expected = load.fetch("simultaneous_uploads")
      raise Error, "seed did not create the requested upload set" unless uploads.length == expected

      gate = Queue.new
      intervals = Array.new(expected)
      threads = uploads.each_with_index.map do |upload, index|
        Thread.new do
          gate.pop
          stream = ThrottledFile.new(image_path)
          started_at = monotonic_time
          begin
            uri = URI("#{@origin}/api/screenshots/#{upload.fetch('screenshot_id')}/upload")
            request = Net::HTTP::Put.new(uri)
            request["Authorization"] = "Bearer #{upload.fetch('token')}"
            request["Content-Type"] = "image/png"
            request.content_length = load.fetch("upload_bytes")
            request.body_stream = stream
            http = Net::HTTP.new(uri.host, uri.port)
            http.open_timeout = 10
            http.read_timeout = 300
            response = http.start { |connection| connection.request(request) }
            metrics.record_http(
              latency_ms: (monotonic_time - started_at) * 1_000,
              response: response,
              expected_status: 200,
              core: false
            )
          rescue StandardError => error
            metrics.record_exception(error)
          ensure
            intervals[index] = [ started_at, monotonic_time ]
            stream.close
          end
        end
      end
      gate.close
      [ threads, intervals ]
    end

    def uploads_overlap?(intervals)
      return false if intervals.any?(&:nil?)

      intervals.map(&:first).max < intervals.map(&:last).min
    end

    def wait_for_queue_drain
      maximum = limits.fetch("queue_drain_seconds_max")
      stdout = docker_rails_runner(
        <<~RUBY,
        require "json"
        maximum = #{maximum}
        started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
        scope = SolidQueue::Job.where(finished_at: nil).where(scheduled_at: ..Time.current)
        depth = scope.count
        while depth.positive? && Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at < maximum
          sleep 1
          depth = scope.count
        end
        puts JSON.generate(
          "seconds" => Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at,
          "depth" => depth
        )
        RUBY
        timeout_seconds: maximum + QUEUE_DRAIN_TIMEOUT_OVERHEAD_SECONDS
      )
      result = parse_runner_json(stdout, "queue drain")
      seconds = Float(result.fetch("seconds"))
      depth = Integer(result.fetch("depth"))
      raise Error, "queue drain response is malformed" if seconds.negative? || depth.negative?

      [ seconds, depth ]
    rescue KeyError, ArgumentError, TypeError
      raise Error, "queue drain response is malformed"
    end

    def reconcile_mutations(workload)
      prefix = workload.fetch(:prefix)
      expected_count = workload.fetch(:expected_count)
      stdout = docker_rails_runner(<<~RUBY)
        require "json"
        bodies = AnnotationComment.where("body LIKE ?", #{JSON.generate("#{prefix}%")}).pluck(:body)
        puts JSON.generate("bodies" => bodies)
      RUBY
      actual = parse_runner_json(stdout, "mutation reconciliation").fetch("bodies")
      self.class.reconcile_mutation_bodies(
        prefix: prefix,
        expected_count: expected_count,
        actual: actual
      )
    end

    def database_integrity_errors
      DATABASES.count do |database|
        output = command!(
          "docker", "exec", container, "sqlite3", "/rails/storage/#{database}.sqlite3",
          "PRAGMA integrity_check; PRAGMA foreign_key_check;"
        ).strip
        output != "ok"
      rescue Error
        true
      end
    end

    def upload_processing_failures(seed)
      ids = seed.fetch("uploads").map { |upload| Integer(upload.fetch("image_id")) }
      stdout = docker_rails_runner(<<~RUBY)
        require "json"
        ids = #{JSON.generate(ids)}
        images = ScreenshotImage.where(id: ids)
        puts JSON.generate("ready" => images.status_ready.count, "total" => images.count)
      RUBY
      result = parse_runner_json(stdout, "upload processing")
      [ ids.length - result.fetch("ready"), 0 ].max
    rescue Error, KeyError, TypeError
      ids&.length || load.fetch("simultaneous_uploads")
    end

    def container_lock_errors
      stdout, _stderr, status = capture_command(
        "docker", "logs", container, timeout_seconds: COMMAND_TIMEOUT_SECONDS
      )
      raise Error, "cannot inspect candidate container logs" unless status.success?

      stdout.each_line.sum { |line| line.scrub.scan(LOCK_PATTERN).length }
    end

    def docker_rails_runner(source, timeout_seconds: COMMAND_TIMEOUT_SECONDS)
      stdout, _stderr, status = capture_command(
        "docker", "exec", "--interactive", container,
        "/rails/bin/docker-entrypoint", "./bin/rails", "runner", "-",
        stdin_data: source,
        timeout_seconds: timeout_seconds
      )
      raise Error, "candidate data operation failed" unless status.success?

      stdout
    end

    def parse_runner_json(stdout, label)
      line = stdout.lines.reverse.find { |candidate| candidate.lstrip.start_with?("{") }
      raise Error, "#{label} did not return structured output" unless line

      JSON.parse(line)
    rescue JSON::ParserError
      raise Error, "#{label} returned malformed structured output"
    end

    def command!(*command)
      stdout, _stderr, status = capture_command(*command, timeout_seconds: COMMAND_TIMEOUT_SECONDS)
      raise Error, "command failed: #{command.fetch(0)}" unless status.success?

      stdout
    end

    def capture_command(
      *command,
      stdin_data: nil,
      timeout_seconds: COMMAND_TIMEOUT_SECONDS,
      termination_grace_seconds: TERMINATION_GRACE_SECONDS
    )
      stdout_data = nil
      stderr_data = nil
      status = nil
      timed_out = false

      Open3.popen3(*command, pgroup: true) do |stdin, stdout, stderr, wait_thread|
        stdout_reader = Thread.new { stdout.read }
        stderr_reader = Thread.new { stderr.read }
        stdin_writer = Thread.new do
          stdin.write(stdin_data) if stdin_data
        rescue Errno::EPIPE, IOError
          nil
        ensure
          stdin.close unless stdin.closed?
        end

        io_threads = [ stdin_writer, stdout_reader, stderr_reader ]
        process_reaped = false
        begin
          deadline = monotonic_time + timeout_seconds
          unless threads_finish_before?([ wait_thread, *io_threads ], deadline)
            timed_out = true
            terminate_process_group(wait_thread, io_threads, termination_grace_seconds)
          end

          status = wait_thread.value
          stdin_writer.value
          stdout_data = stdout_reader.value
          stderr_data = stderr_reader.value
          process_reaped = true
        ensure
          terminate_process_group(wait_thread, io_threads, termination_grace_seconds) unless process_reaped
        end
      end

      raise Error, "command timed out: #{command.fetch(0)}" if timed_out

      [ stdout_data, stderr_data, status ]
    rescue Errno::ENOENT => error
      raise Error, "cannot run command #{command.fetch(0)}: #{error.message}"
    end

    def threads_finish_before?(threads, deadline)
      threads.each do |thread|
        next unless thread.alive?

        remaining = deadline - monotonic_time
        return false unless remaining.positive? && thread.join(remaining)
      end
      true
    end

    def terminate_process_group(wait_thread, io_threads, termination_grace_seconds)
      signal_process_group("TERM", wait_thread.pid)
      threads_finish_before?(
        [ wait_thread, *io_threads ],
        monotonic_time + termination_grace_seconds
      )
    ensure
      signal_process_group("KILL", wait_thread.pid) if wait_thread.alive? || io_threads.any?(&:alive?)
      wait_thread.value
      io_threads.each(&:join)
    end

    def signal_process_group(signal, pid)
      Process.kill(signal, -pid)
    rescue Errno::ESRCH
      nil
    end

    def cleanup!(raise_on_failure: true)
      failures = []
      if @container_started
        failures << "container" unless cleanup_command_succeeds?("docker", "rm", "--force", container)
      end
      if @volume_created
        failures << "volume" unless cleanup_command_succeeds?("docker", "volume", "rm", "--force", volume)
      end
      FileUtils.remove_entry(root) if root && File.directory?(root)
      return if failures.empty?

      message = "cannot clean up qualification #{failures.join(' and ')}"
      raise Error, message if raise_on_failure

      warn "self-hosted load driver: #{message}"
    end

    def cleanup_command_succeeds?(*command)
      _stdout, _stderr, status = capture_command(*command, timeout_seconds: CLEANUP_TIMEOUT_SECONDS)
      status.success?
    rescue Error
      false
    end

    def monotonic_time
      Process.clock_gettime(Process::CLOCK_MONOTONIC)
    end
  end

  def self.run(environment = ENV)
    previous_term_handler = Signal.trap("TERM") { raise Interrupt }
    Runner.new(environment).run
    0
  rescue Error => error
    warn "self-hosted load driver: #{error.message}"
    1
  rescue Interrupt
    warn "self-hosted load driver: interrupted"
    130
  ensure
    Signal.trap("TERM", previous_term_handler) if previous_term_handler
  end
end

exit ScreenoteLoadDriver.run if $PROGRAM_NAME == __FILE__
