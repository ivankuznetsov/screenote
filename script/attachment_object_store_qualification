#!/usr/bin/env bash

# Runs the S3 delivery gate against a real object store.
#
# Disk storage has no presigned URL to leak and no remote host to redirect to,
# so "the application streams the bytes itself" cannot be executed against it.
# This script runs the gate against an S3-compatible bucket you already have —
# a dedicated test bucket on the hosted provider, for instance. No workflow
# runs it, because no object store is started for the test run.
#
#   SCREENOTE_S3_ENDPOINT=https://... SCREENOTE_S3_REGION=... \
#   SCREENOTE_S3_BUCKET=... SCREENOTE_S3_PREFIX=... \
#   SCREENOTE_S3_ACCESS_KEY_ID=... SCREENOTE_S3_SECRET_ACCESS_KEY=... \
#     script/attachment_object_store_qualification
#
# Use a bucket and prefix reserved for tests: the gate creates and deletes
# objects under that prefix.

set -Eeuo pipefail
umask 077

readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

fail() {
  printf 'attachment object store qualification: %s\n' "$*" >&2
  exit 1
}

cd "${REPOSITORY_ROOT}"

for name in SCREENOTE_S3_ENDPOINT SCREENOTE_S3_REGION SCREENOTE_S3_BUCKET SCREENOTE_S3_PREFIX \
  SCREENOTE_S3_ACCESS_KEY_ID SCREENOTE_S3_SECRET_ACCESS_KEY; do
  [[ -n "${!name-}" ]] || fail "${name} must be set to an object store you already run"
done

# The s3 gate exports SCREENOTE_REQUIRE_S3, which turns the suite's "no store
# configured" skip into a failure, so this run cannot pass by not running.
script/release_test_matrix s3
