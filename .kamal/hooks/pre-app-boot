#!/usr/bin/env bash

set -Eeuo pipefail

# Run compatible migrations from the candidate image before it starts. The
# pre-deploy guard blocks the one irreversible credential conversion until the
# dedicated stopped-process command has completed it.
bin/kamal app exec \
  --primary \
  --version "${KAMAL_VERSION:?KAMAL_VERSION is required}" \
  "bin/rails db:migrate"
