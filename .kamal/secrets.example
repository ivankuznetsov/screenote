# Copy this file to .kamal/secrets. Kamal reads it as a shell environment file,
# and .kamal/secrets is ignored by Git.
#
# Generate these values once and paste the outputs below:
#   bin/rails secret
#   openssl rand -hex 32

SECRET_KEY_BASE=
SCREENOTE_BOOTSTRAP_TOKEN=

# External transactional email (optional):
# SMTP_USERNAME=
# SMTP_PASSWORD=

# S3-compatible screenshot storage (optional):
# SCREENOTE_S3_ACCESS_KEY_ID=
# SCREENOTE_S3_SECRET_ACCESS_KEY=

# Social sign-in and monitoring (optional):
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=
# HONEYBADGER_API_KEY=
