# Copy this file to .env beside compose.yaml and replace the release placeholder
# with the immutable digest from Screenote's release notes.
SCREENOTE_IMAGE=ghcr.io/ivankuznetsov/screenote@sha256:REPLACE_WITH_RELEASE_DIGEST

# The externally reachable origin, with no path, query, or fragment.
SCREENOTE_BASE_URL=http://screenote.internal:3005
SCREENOTE_PORT=3005

# Non-secret runtime settings. The base Compose file always selects local
# storage; add compose.s3.yaml to select the generic S3-compatible profile.
SCREENOTE_TRUSTED_PROXIES=
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3

# This file is required for every start. Keep it owned by uid 1000 and mode
# 0400. Never put the value itself in this environment file.
SCREENOTE_SECRET_KEY_BASE_PATH=./secrets/secret_key_base

# Add compose.auth-link-key-rotation.yaml only while unexpired authentication
# links still depend on a prior application secret. See docs/self-hosting/secrets.md.
SCREENOTE_AUTHENTICATION_LINK_PRIOR_KEYS_PATH=./secrets/authentication_link_prior_keys

# Add compose.bootstrap.yaml only while claiming a fresh installation. Remove
# that overlay and this file after the claim succeeds.
SCREENOTE_BOOTSTRAP_TOKEN_PATH=./secrets/bootstrap_token

# Generic S3-compatible storage settings used only with compose.s3.yaml.
SCREENOTE_S3_ENDPOINT=https://objects.example.test
SCREENOTE_S3_REGION=local
SCREENOTE_S3_BUCKET=screenote-private
SCREENOTE_S3_PREFIX=replace-with-a-dedicated-prefix
SCREENOTE_S3_PATH_STYLE=true
SCREENOTE_S3_REQUEST_TIMEOUT=30
SCREENOTE_S3_RETRY_LIMIT=3
SCREENOTE_S3_REQUEST_CHECKSUM_CALCULATION=when_supported
SCREENOTE_S3_RESPONSE_CHECKSUM_VALIDATION=when_supported

# S3 credentials are restricted files, never values in .env.
SCREENOTE_S3_ACCESS_KEY_ID_PATH=./secrets/s3_access_key_id
SCREENOTE_S3_SECRET_ACCESS_KEY_PATH=./secrets/s3_secret_access_key

# Optional SMTP settings used only with compose.smtp.yaml.
SMTP_ADDRESS=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=screenote
SMTP_DOMAIN=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
MAILER_FROM=screenote@example.test
SCREENOTE_SMTP_PASSWORD_PATH=./secrets/smtp_password

# Optional social sign-in settings. Add either or both OAuth overlays.
GOOGLE_CLIENT_ID=replace-with-google-client-id
SCREENOTE_GOOGLE_CLIENT_SECRET_PATH=./secrets/google_client_secret
GITHUB_CLIENT_ID=replace-with-github-client-id
SCREENOTE_GITHUB_CLIENT_SECRET_PATH=./secrets/github_client_secret

# Optional server-side monitoring used only with compose.honeybadger.yaml.
SCREENOTE_HONEYBADGER_API_KEY_PATH=./secrets/honeybadger_api_key
